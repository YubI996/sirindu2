{
  "permissions": {
    "allow": [
      "Bash(git checkout:*)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan optimize:*)",
      "Bash(composer update:*)",
      "Bash(composer show:*)",
      "Bash(php artisan optimize:clear:*)",
      "Bash(php artisan:*)",
      "Bash(git merge:*)",
      "Bash(composer require:*)",
      "Bash(php:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(powershell:*)",
      "Bash(grep -E 'refs/heads/[0-9]+-pd3i-form-surveilans$')",
      "Bash(grep -E '^[* ]*[0-9]+-pd3i-form-surveilans$')",
      "Bash(grep -E '^[0-9]+-pd3i-form-surveilans$')"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "php .claude/hooks/php-lint.php",
            "statusMessage": "Memeriksa sintaks PHP..."
          }
        ]
      }
    ]
  }
}
